# Copy to .env and fill only the providers you want to use.
# Never commit a real .env file.

AAR_ENV=local
AAR_HOST=127.0.0.1
AAR_PORT=8000

# Network-free demo. Labeled fixtures and fake models only.
AAR_ENABLE_FAKE=true
AAR_WEB_MODE=fixture
AAR_DEMO_FIXTURES=true

# Web search (not a model). Leave blank to skip live web research.
AAR_TAVILY_API_KEY=
# Optional per-search estimate. Leave unset so Tavily is not part of the hard ceiling.
# AAR_TAVILY_COST_USD=

# Local models: install Ollama, pull a chat model, set AAR_ENABLE_FAKE=false.
# AAR_OLLAMA_CHAT_MODEL overrides catalog vendor ids (use the exact `ollama list` name).
# Set AAR_LIVE_OLLAMA=true to include Ollama in pytest -m live.
AAR_OLLAMA_HOST=http://127.0.0.1:11434
AAR_OLLAMA_CHAT_MODEL=
AAR_LIVE_OLLAMA=false

# AWS Bedrock: set true only when AWS credentials are already in the environment.
AAR_ENABLE_BEDROCK=false
AAR_AWS_REGION=us-east-1

# Hosted model keys. Any one of these is enough; they are not required if Ollama or Bedrock is used.
AAR_GEMINI_API_KEY=
AAR_ANTHROPIC_API_KEY=
AAR_OPENROUTER_API_KEY=
AAR_ALLOW_PREMIUM=false
AAR_MAX_OUTPUT_TOKENS=1024
